# API Configuration
API_BASE_URL=http://10.0.2.2:8000/api/v1
# For physical device, use your computer's IP address:
# API_BASE_URL=http://192.168.1.100:8000/api/v1

# App Configuration
APP_NAME=DukaPOS
APP_VERSION=1.0.0

# Feature Flags
ENABLE_SYNC=true
ENABLE_MONITORING=true
ENABLE_CRASH_REPORTING=true

# Debugging
DEBUG_MODE=false

# Subscription Plans (KES, minor units — cents)
# Adjust these to change pricing without rebuilding the app
PLAN_DAILY_PRICE=10000
PLAN_WEEKLY_PRICE=60000
PLAN_MONTHLY_PRICE=200000
PLAN_LIFETIME_PRICE=1000000
