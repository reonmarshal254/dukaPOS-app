# ── DukaPOS Production Environment ──────────────────────────────────────────
# This file is loaded when APP_VARIANT=production.
# In EAS builds, secrets are injected via eas.json env or EAS Secrets.
# Do NOT commit real secrets to version control.

# App
APP_VARIANT=production
APP_NAME=DukaPOS
APP_VERSION=1.0.0

# Admin backend (deployed on Render/Railway)
# Replace with your actual deployed URL after the backend is live
ADMIN_API_URL=https://dukapos-admin.onrender.com

# Feature flags
ENABLE_SYNC=true
ENABLE_MONITORING=true
ENABLE_CRASH_REPORTING=true
DEBUG_MODE=false
